# ===================================================================
# Automação GEDI - Variáveis de Ambiente
# ===================================================================
# ⚠️ NUNCA commite este arquivo preenchido!
# Use este como template e preencha com seus valores reais.
# Renomeie para .env após preencher.
# ===================================================================

# ===== BANCO DE DADOS =====
# Credenciais de acesso ao MySQL (tim_producao)
DB_HOST=seu-host-mysql
DB_PORT=3306
DB_NAME=tim_producao
DB_USER=seu-usuario-mysql
DB_PASSWORD=sua-senha-super-secreta

# ===== USUÁRIO =====
# Código do usuário responsável pelos envios (tabela: tab_protocolos_enviados)
COD_USUARIO=seu-codigo-usuario

# ===== API GEDI =====
# Endpoint e token da API de e-mail do GEDI
URL_EMAIL=https://api.gedi.com/send-email
EMAIL_API_TOKEN=seu-token-api-super-secreto

# ===== E-MAILS =====
# Destinatário das faturas e cópia (BCC)
GEDI_EMAIL=gedi@email.com.br
BCC=seu-email@empresa.com,auditoria@empresa.com

# ===== CAMINHOS =====
# Pasta para relatórios adicionais
PATH_RELATORIO=./output/relatorios
